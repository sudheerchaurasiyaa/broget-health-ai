{
  "name": "health-broget-api",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22"
  },
  "main": "src/function.js",
  "scripts": {
    "dev": "node --env-file=.env.local src/local.js",
    "start": "node src/server.js",
    "check:ai": "node --env-file=.env.local src/check-ai.js",
    "test": "node --test test/core.test.js test/ai_transport.test.js test/calendar.test.js test/runtime_config.test.js test/hosted_server.test.js",
    "test:rules": "node --test test/rules.test.js",
    "check": "node --check src/app.js && node --check src/provider.js && node --check src/tools.js && node --check src/server.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "sharp": "^0.35.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.3.0",
    "supertest": "^7.1.4"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  }
}
