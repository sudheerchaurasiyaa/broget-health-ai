APP_ENV=production
GCLOUD_PROJECT=broget-health-ai
ALLOWED_ORIGINS=https://broget-health-ai.web.app,https://broget-health-ai.firebaseapp.com
AI_MODEL=gemini-3.5-flash
# Set the real value privately in Render Environment. Never in client config.
AI_API_KEY=
# Optional: USDA FoodData Central search. AI photo estimates work without it.
USDA_API_KEY=
# Upload the credential as a Render Secret File with this exact filename.
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase-admin.json
